<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Local Agent</string>
	<key>NSCameraUsageDescription</key>
	<string>The camera is used once to scan the QR code on your computer and pair this phone. No photos or video are saved.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>The microphone is used to dictate messages to your agent. Dictation runs on-device; no audio leaves the phone.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Speech recognition turns your dictated messages into text on this phone, so you can talk to your agent.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.localagent.companion.refresh</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- The app talks plain HTTP to the user's own computer only: its LAN
		     address at home and its Tailscale address away from home. No
		     internet host is ever contacted, so there is no HTTPS endpoint
		     to use. NSAllowsLocalNetworking covers the LAN case;
		     NSAllowsArbitraryLoads is needed as well because Tailscale
		     addresses (100.64.0.0/10) are not RFC 1918 local addresses. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
